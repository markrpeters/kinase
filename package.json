{
  "name": "@pricklypete/kinase",
  "version": "0.1.0",
  "description": "A harness that activates agents: scouts, fanout, and a runner over pi.",
  "author": "Mark Peters",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bash scripts/run-suites.sh",
    "scan": "bash scripts/ip_scan.sh . scan-out",
    "verify": "npm run setup && npm run typecheck && npm test && npm run scan"
  },
  "keywords": [
    "pi-package",
    "agents",
    "fanout",
    "harness",
    "ollama"
  ],
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "jiti": "^2.7.0",
    "typescript": "^5.9.3"
  },
  "pi": {
    "extensions": [
      "./src/scout-tool.ts",
      "./src/runner-tool.ts"
    ]
  }
}
